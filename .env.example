# ---------------------------------------------------------------------------
# forge-tool configuration
#
# Copy to .env and edit. .env is git-ignored; .env.example is committed.
#   cp .env.example .env
#
# Everything the app and the infra scripts read lives here. No secrets in this
# file: the GitHub PAT and the git SSH key are stored in AWS SSM Parameter
# Store (see infra/put_ssm_parameters.sh).
# ---------------------------------------------------------------------------

# --- AWS -------------------------------------------------------------------
AWS_REGION=us-east-1
# Credentials. The app and every infra script read this file, so values set
# here work no matter which shell exported them. A variable already exported
# in the environment always wins. Prefer a named profile created with
# `aws configure --profile <name>`; static keys also work. Leave all of them
# blank to use the default AWS credential chain. .env is git-ignored.
#AWS_PROFILE=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# Parent of the per-run sandbox (clone, edits, test output). Empty = system temp.
# On Windows use a short path, e.g. C:\forge-work, to stay under path-length limits.
WORK_ROOT=

# --- Bedrock model ---------------------------------------------------------
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_REGION=us-east-1
BEDROCK_MAX_TOKENS=10000
BEDROCK_TEMPERATURE=0.0
# botocore client timeouts (seconds) and retry budget
BEDROCK_CONNECT_TIMEOUT=240
BEDROCK_READ_TIMEOUT=240
BEDROCK_MAX_ATTEMPTS=2
# Max agent steps (model calls + tool runs) per turn. A multi-module migration
# takes a few hundred; hitting the limit pauses the turn (Continue button).
AGENT_RECURSION_LIMIT=400
# Mid-turn context compaction. Past TRIGGER tokens the older history is replaced
# by a summary and the last KEEP messages stay verbatim, so long migrations keep
# going instead of the model stopping "due to token limits".
AGENT_SUMMARY_ENABLED=true
AGENT_SUMMARY_TRIGGER_TOKENS=120000
AGENT_SUMMARY_KEEP_MESSAGES=30
# Only the last N characters of a Maven log follow the parsed summary.
MAVEN_OUTPUT_MAX_CHARS=6000

# --- Knowledge base (runtime) ----------------------------------------------
# Leave KNOWLEDGE_BASE_ID empty to resolve it from SSM
# (${PARAMETER_STORE_PREFIX}knowledge_base_id), which infra/deploy.sh writes.
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_REGION=us-east-1
KNOWLEDGE_BASE_NUM_RESULTS=4
# Local folder of guideline docs uploaded to the knowledge base data source.
KNOWLEDGE_BASE_DIRECTORY=./knowledge-base

# --- SSM Parameter Store ---------------------------------------------------
PARAMETER_STORE_PREFIX=forge_tool_
# Comma-separated parameter names, read without the prefix.
# PAT-only auth: just the GitHub token. Store it with put_ssm_parameters.sh --pat-only.
SSM_PARAMETER_NAMES=api_key

# --- Git / GitHub ----------------------------------------------------------
GIT_COMMIT_AUTHOR_NAME=upgrade-code-bot
GIT_COMMIT_AUTHOR_EMAIL=upgrade@code.bot
# Branch the target repo is cloned at and that the upgrade branch is cut from.
# Empty = the repo's default branch.
GIT_SOURCE_BRANCH=simple-app
# Branch the pull request targets. Must exist in the target repo.
GIT_BASE_BRANCH=simple-app
GITHUB_API_TIMEOUT=30
GITHUB_API_VERSION=2022-11-28

# --- Upgrade run defaults --------------------------------------------------
# Used when --github_url / --upgrade_details are not passed on the CLI.
# Clone/push/PR all authenticate with the GitHub PAT over HTTPS.
DEFAULT_GITHUB_URL=https://github.com/anche-raja/ams.git
DEFAULT_UPGRADE_DETAILS="Java 21"

# --- Streamlit app ---------------------------------------------------------
APP_ENTRYPOINT=python/chat.py
APP_PAGE_TITLE="Forge Chatbot"
APP_PAGE_ICON=🤖
APP_CAPTION="Powered by AWS Bedrock & Streamlit"
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=false

# --- Logging ---------------------------------------------------------------
LOG_NAME=FORGE_TOOL
LOG_LEVEL=DEBUG
ROOT_LOG_LEVEL=INFO

# --- Guardrails ------------------------------------------------------------
# Bedrock guardrail attached to every model call. Empty = resolve from SSM
# (${PARAMETER_STORE_PREFIX}guardrail_id / _version, written by infra/deploy.sh).
# None found = run without a Bedrock guardrail; local secret scanning still applies.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
GUARDRAIL_TRACE=false
# Local secret scanner: refuses writes and commits that add keys, tokens or passwords.
SECRET_SCAN_ENABLED=true
# ';'-separated regexes; a line matching any of them is never reported.
SECRET_SCAN_ALLOWLIST=

# Repository personal-data scan (Amazon Bedrock ApplyGuardrail, report only).
# The guardrail id/version are written by infra/deploy.sh; empty = resolve from SSM.
PII_SCAN_ENABLED=true
PII_SCAN_GUARDRAIL_ID=
PII_SCAN_GUARDRAIL_VERSION=
# Comma-separated globs of the data-bearing files sent to Bedrock.
PII_SCAN_GLOBS=**/*.sql,**/*.csv,**/*.json,**/*.properties,**/*.yml,**/*.yaml,**/*.txt,**/src/test/resources/**,**/src/main/resources/**,**/src/test/java/**/*.java
# Characters per ApplyGuardrail call, and the per-scan budget (1,000 chars = 1 text unit).
PII_SCAN_CHUNK_CHARS=10000
PII_SCAN_MAX_CHARS=1500000

# --- Reviewer model (second opinion on every migrated file) ----------------
REVIEWER_ENABLED=true
REVIEWER_MODEL_ID=us.amazon.nova-pro-v1:0
REVIEWER_MODEL_REGION=us-east-1
REVIEWER_MAX_TOKENS=2000
# Files scoring below this (0-10) are sent to the chat for manual review.
REVIEW_SCORE_THRESHOLD=7
REVIEW_MAX_DIFF_CHARS=60000

# --- Pull request gate -----------------------------------------------------
# block = refuse the PR until the final tests compile with no new failures, the
# approved packs are clean (or their leftovers are named in the PR) and tests keep
# their meaning; draft = open it as a GitHub draft with the failures on top; off.
PR_GATE=block

# --- Migration plan --------------------------------------------------------
# The agent detects the repo's tech stack, maps it to the guideline packs and
# proposes a plan. true = wait for your approval before editing anything;
# false = inform and proceed.
MIGRATION_PLAN_APPROVAL=true

# --- Local toolchain (used by infra/setup.sh) ------------------------------
VENV_DIR=.venv
PYTHON_BIN=python3
# JDK used by the maven test tool. JAVA_VERSION is a pin and takes
# precedence over an inherited JAVA_HOME; blank both to autodetect.
JAVA_VERSION=21
#JAVA_HOME=/path/to/jdk

# ===========================================================================
# Infrastructure (infra/deploy.sh, infra/put_ssm_parameters.sh)
# ===========================================================================
PROJECT_NAME=forge-tool
# Terraform manages three parts (infra/terraform/). Set one to false to remove
# it from the deployment entirely; to skip a part for a single run instead,
# use deploy.sh --no-kb / --guardrail-only etc.
CREATE_KNOWLEDGE_BASE=true
CREATE_GUARDRAIL=true
CREATE_PERMISSIONS=true

# Bedrock knowledge base
KB_NAME=forge-tool-knowledge-base
KB_DESCRIPTION="Company coding guidelines for J2EE/Spring/Struts upgrades"
KB_DATA_SOURCE_NAME=forge-tool-guidelines
KB_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Must be a size the embedding model supports (Titan v2: 1024, 512 or 256).
# Applied to both the vector index and the knowledge base.
KB_EMBEDDING_DIMENSIONS=1024
KB_CHUNK_MAX_TOKENS=500
KB_CHUNK_OVERLAP_PERCENT=20

# S3 Vectors store: billed per request and per GB, no provisioned capacity.
# Bucket/index names: lowercase letters, digits, hyphens; 3-63 characters.
# Empty bucket name = <PROJECT_NAME>-vectors-<account-id>-<region>.
KB_VECTOR_BUCKET_NAME=
KB_VECTOR_INDEX_NAME=forge-tool-kb-index
KB_DISTANCE_METRIC=cosine

# S3 bucket holding the knowledge base documents.
# Empty = <PROJECT_NAME>-kb-<account-id>-<region>.
KB_DOCS_BUCKET_NAME=
KB_DOCS_PREFIX=guidelines/

# Bedrock guardrail (pay-per-use, no standing cost)
GUARDRAIL_NAME=forge-tool-guardrail
# ANONYMIZE masks detected PII values with tags; BLOCK rejects the whole request/response.
GUARDRAIL_PII_ACTION=ANONYMIZE

# IAM runtime permissions: one managed policy with exactly what the app
# needs (invoke both models, apply the guardrail, query the KB, read SSM).
# Who the policy is attached to: auto = the identity running deploy.sh,
# user:<name>, role:<name>, or none (attach the output PolicyArn yourself).
APP_IAM_PRINCIPAL=auto
# Foundation models behind BEDROCK_MODEL_ID / REVIEWER_MODEL_ID; a cross-region
# inference profile routes to these, so the policy allows them in every region.
PRIMARY_BASE_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
REVIEWER_BASE_MODEL_ID=amazon.nova-pro-v1:0
